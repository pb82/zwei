#!/usr/bin/env python3
"""Create scaffolding for Zwei map and tileset assets.

Usage:
  create-asset --map     --name <name> --size <WxH> [--tileset <name>] [--create-scene]
  create-asset --tileset --name <name> --size <WxH>

Examples:
  create-asset --map --name testmap --size 20x20
  create-asset --map --name testmap --size 20x20 --tileset MyTiles --create-scene
  create-asset --tileset --name testtiles --size 20x20

Maps are created in     assets/NEW/MAPS/<Name>.json
Tilesets are created in assets/NEW/TILESETS/<Name>.json + <Name>.png
Scenes are created in   scenes/<name>.lua  (with --create-scene)
"""

import argparse
import json
import os
import struct
import sys
import zlib

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
MAPS_DIR = os.path.join(PROJECT_ROOT, "assets", "NEW", "MAPS")
TILESETS_DIR = os.path.join(PROJECT_ROOT, "assets", "NEW", "TILESETS")
SCENES_DIR = os.path.join(PROJECT_ROOT, "scenes")

TILE_SIZE = 16


def parse_size(s):
    parts = s.lower().split("x")
    if len(parts) != 2:
        raise argparse.ArgumentTypeError(f"Size must be WxH, got '{s}'")
    try:
        w, h = int(parts[0]), int(parts[1])
    except ValueError:
        raise argparse.ArgumentTypeError(f"Size must be WxH with integers, got '{s}'")
    if w <= 0 or h <= 0:
        raise argparse.ArgumentTypeError("Width and height must be positive")
    return w, h


def make_blank_png(width, height):
    """Generate a minimal valid RGBA PNG (transparent) without Pillow."""
    def chunk(chunk_type, data):
        c = chunk_type + data
        crc = struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF)
        return struct.pack(">I", len(data)) + c + crc

    signature = b"\x89PNG\r\n\x1a\n"
    ihdr_data = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)  # 8-bit RGBA
    raw_scanlines = b""
    for _ in range(height):
        raw_scanlines += b"\x00" + b"\x00\x00\x00\x00" * width  # filter=None, transparent
    compressed = zlib.compress(raw_scanlines)

    return signature + chunk(b"IHDR", ihdr_data) + chunk(b"IDAT", compressed) + chunk(b"IEND", b"")


def make_layer(name, layer_id, w, h, tileset_name=None):
    layer = {
        "data": [0] * (w * h),
        "height": h,
        "id": layer_id,
        "name": name,
        "opacity": 1,
        "type": "tilelayer",
        "visible": True,
        "width": w,
        "x": 0,
        "y": 0,
    }
    if tileset_name:
        layer["properties"] = [{
            "name": "metadata",
            "type": "string",
            "value": tileset_name + ".json"
        }]
    else:
        layer["properties"] = []
    return layer


def create_map(name, w, h, tileset_name):
    os.makedirs(MAPS_DIR, exist_ok=True)
    path = os.path.join(MAPS_DIR, name + ".json")
    if os.path.exists(path):
        print(f"Error: {path} already exists", file=sys.stderr)
        sys.exit(1)

    layers = [
        make_layer("background", 1, w, h),
        make_layer("floor", 2, w, h, tileset_name),
        make_layer("walls", 3, w, h, tileset_name),
        make_layer("roof", 4, w, h),
        make_layer("sky", 5, w, h),
    ]

    map_data = {
        "compressionlevel": -1,
        "height": h,
        "infinite": False,
        "layers": layers,
        "nextlayerid": len(layers) + 1,
        "nextobjectid": 1,
        "orientation": "orthogonal",
        "renderorder": "right-down",
        "tiledversion": "1.7.2",
        "tileheight": TILE_SIZE,
        "tilesets": [{
            "firstgid": 1,
            "source": "../TILESETS/" + tileset_name + ".json"
        }],
        "tilewidth": TILE_SIZE,
        "type": "map",
        "version": "1.6",
        "width": w,
    }

    with open(path, "w") as f:
        json.dump(map_data, f, indent=1)
        f.write("\n")

    print(f"Created map: {path}")


def create_tileset(name, w, h):
    os.makedirs(TILESETS_DIR, exist_ok=True)
    json_path = os.path.join(TILESETS_DIR, name + ".json")
    png_path = os.path.join(TILESETS_DIR, name + ".png")

    if os.path.exists(json_path):
        print(f"Error: {json_path} already exists", file=sys.stderr)
        sys.exit(1)
    if os.path.exists(png_path):
        print(f"Error: {png_path} already exists", file=sys.stderr)
        sys.exit(1)

    pixel_w = w * TILE_SIZE
    pixel_h = h * TILE_SIZE

    tileset_data = {
        "columns": w,
        "image": name + ".png",
        "imageheight": pixel_h,
        "imagewidth": pixel_w,
        "margin": 0,
        "name": name,
        "spacing": 0,
        "tilecount": w * h,
        "tiledversion": "1.7.2",
        "tileheight": TILE_SIZE,
        "tiles": [],
        "tilewidth": TILE_SIZE,
        "type": "tileset",
        "version": "1.6",
    }

    with open(json_path, "w") as f:
        json.dump(tileset_data, f, indent=1)
        f.write("\n")

    png_data = make_blank_png(pixel_w, pixel_h)
    with open(png_path, "wb") as f:
        f.write(png_data)

    print(f"Created tileset: {json_path}")
    print(f"Created image:   {png_path} ({pixel_w}x{pixel_h}px)")


def create_scene(name, map_filename):
    os.makedirs(SCENES_DIR, exist_ok=True)
    path = os.path.join(SCENES_DIR, name.lower() + ".lua")
    if os.path.exists(path):
        print(f"Error: {path} already exists", file=sys.stderr)
        sys.exit(1)

    content = f"""function setup()
    local x, y = zwei.pop_player_position()
    if not x then x, y = 2, 2 end
    zwei.set_player_position(x, y)

    zwei.load_map("{map_filename}")
    zwei.set_game_state()
end

function teardown()
    zwei.push_player_position()
    zwei.unload_map()
end
"""
    with open(path, "w") as f:
        f.write(content)

    print(f"Created scene:   {path}")


def main():
    parser = argparse.ArgumentParser(
        description="Create Zwei map or tileset assets"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--map", action="store_true", help="Create a new map")
    group.add_argument("--tileset", action="store_true", help="Create a new tileset")
    parser.add_argument("--name", required=True, help="Asset name (used for filenames)")
    parser.add_argument("--size", required=True, help="Size as WxH (in tiles)")
    parser.add_argument("--tileset-name", default="Tiles",
                        help="Tileset to reference in map layers (default: Tiles)")
    parser.add_argument("--create-scene", action="store_true",
                        help="Also create a Lua scene file (only with --map)")

    args = parser.parse_args()
    w, h = parse_size(args.size)

    if args.create_scene and not args.map:
        parser.error("--create-scene can only be used with --map")

    if args.map:
        create_map(args.name, w, h, args.tileset_name)
        if args.create_scene:
            create_scene(args.name, args.name + ".json")
    elif args.tileset:
        create_tileset(args.name, w, h)


if __name__ == "__main__":
    main()
